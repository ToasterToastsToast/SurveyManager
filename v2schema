  "password": String,           // 密码 [cite: 4]
  "email": String,              // 邮箱 [cite: 4]
  "created_surveys": [ObjectId],// 创建的问卷ID [cite: 4]
  "submitted_answers": [ObjectId], // 提交的回答ID [cite: 4]
  "question_banks": [ObjectId], // 【新增】用户拥有或加入的题库ID列表
  "created_at": Date,           // 注册时间 [cite: 4]
